# LLM Provider (volc / deepseek)
LLM_PROVIDER=volc

# Volcengine (Doubao) DeepSeek
VOLC_API_KEY=your_volc_api_key
VOLC_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VOLC_CHAT_MODEL=deepseek-v4-flash-ga-260731

# DeepSeek Official
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# ComfyUI 地址
COMFYUI_URL=http://127.0.0.1:8188

# 单次生图等待上限（秒）。批量逐张串行，张数多时要调大，否则整批会被掐断
IMAGE_GEN_TIMEOUT=3600

# 生图工具开关：没装 ComfyUI 的机器设为 false，不注册 generate_image 工具
ENABLE_IMAGE_GEN=true

# Agent 配置
AGENT_PORT=5174
MAX_TURNS=10

# RAG 向量知识库
LOCAL_EMBEDDING_MODEL=BAAI/bge-m3
RAG_EMBED_DEVICE=cuda
RAG_AUTO_DOWNLOAD=0
RAG_RETRIEVE_K=4
# RAG_DATA_DIR=./vector_store/chroma

# ─── QQ 接入（NapCat / OneBot 11）─────────────────────
# 适配层是独立进程，单独启动：python -m app.qq_bot
# 前置：本机跑起 NapCat（建议用小号扫码登录），并在它的 WebUI「网络配置」里
# 分别新建并启用【WebSocket 服务端】(默认 3001) 和【HTTP 服务端】(默认 3000)
QQ_ENABLE=false

# 协议端地址：WS 收事件，HTTP 发消息
QQ_WS_URL=ws://127.0.0.1:3001
QQ_HTTP_URL=http://127.0.0.1:3000
# NapCat 网络配置里填的访问令牌。留空表示不鉴权（仅限本机自用）
QQ_TOKEN=

# 用哪个 agent 的人设与工具白名单（对应 agents/ 下的目录名）
QQ_AGENT_ID=qq

# 触发规则
QQ_PRIVATE_ENABLE=true
# 群里是否必须 @ 才回；设为 false 则群里所有消息都回
QQ_GROUP_AT_ONLY=true
# 群里命中这些词就直接回，不需要 @。多个用英文逗号分隔
QQ_GROUP_KEYWORDS=

# 名单，留空表示不限。黑名单优先于白名单
QQ_WHITELIST_GROUPS=
QQ_WHITELIST_USERS=
QQ_BLACKLIST_USERS=

# 跨会话并发上限（同一条会话线永远串行，这里限的是不同会话之间的并行数）
QQ_MAX_CONCURRENCY=2
# 单条消息字数上限，超出按段落切分成多条发送
QQ_REPLY_MAX_CHARS=700
# 连发消息的合并静默窗口（秒）：群里连发几句会攒成一轮处理
QQ_DEBOUNCE_SECONDS=1.5
