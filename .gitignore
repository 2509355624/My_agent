# 环境变量（各类备份也一并忽略，避免真实密钥进仓库）
.env
.env.*
!.env_example

# 会话数据（旧单会话文件所在目录，保留忽略以防残留）
data/

# Agent 定义与各自的会话（人设 + 白名单 + 会话历史，属本机私有数据）
# 想让人设 / 白名单进仓库的话，把这行换成只忽略会话文件：
#   agents/*/session.jsonl
agents/

# Skills（本地技能，不上传）
skills/

# WorkBuddy 运行时数据（每日工作日志 memory/、自动化定义 automations/）。
# ⚠️ 这个仓库是 public：memory 里会写本机路径、私有部署细节、翻车记录，
# automations 里是 UUID 目录——都不该被提交。
.workbuddy-ai/

# Skills 迁移备份（搬家前的逐字节副本，保留 2 周后手动删除）
skills_bak_20260915/

# 文档（用户本地文档，不上传）
documents/

# 向量知识库
vector_store/

# QQ 适配层单实例锁（运行时状态文件）
.qq_bot.lock

# Python 缓存
__pycache__/
*.pyc
*.pyo
*/__pycache__/

# IDE
.vscode/
.idea/
usage/

# 状态后台心跳（state/qq_status.json）：qq_bot 每秒写的运行时快照
state/

# 运行日志（logs/qq_bot.log、logs/agent.log，含模型调用与降级记录）
logs/

# 排查问题时的本地残留：诊断脚本、diff 转储、临时抓的 stdout/stderr。
# 都带 `_` 前缀或固定名，跑完就该删；万一忘了也不该被顺手提交进来。
_local*
_test*
server_*.log
DIAG.bat
check_proc.ps1
新建 文本文档.txt

# 向量库的手工备份（搬家/重建时留的副本，不是运行所需）
vector_store_backup_local/
